{
  "name": "@elderengineer/pg-workflow",
  "version": "0.1.2",
  "description": "Standalone queue-agnostic workflow engine with pluggable queue backends and observability hooks.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "workflow",
    "queue",
    "pg-boss",
    "postgres",
    "background-jobs",
    "job-queue"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elderengineer/pg-workflow.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run",
    "test": "jest tests/unit --runInBand --forceExit",
    "test:integration": "jest tests/integration --runInBand --forceExit --transform-ignore-patterns='a^'",
    "test:all": "npm test && npm run test:integration",
    "lint": "eslint src tests",
    "admin": "node scripts/pg-workflow-admin.mjs",
    "bench": "node bench/stateless-bench.mjs",
    "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"bench/**/*.mjs\" \"docs/**/*.md\" \"README.md\"",
    "format:write": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"bench/**/*.mjs\" \"docs/**/*.md\" \"README.md\"",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down"
  },
  "peerDependencies": {
    "pg": "^8.23.0",
    "pg-boss": "^12.32.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "pg-boss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.32.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.8.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.[tj]sx?$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!pg-boss/)"
    ]
  }
}
